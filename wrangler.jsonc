{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Stays "blakebauman-dev" after the move to blakebauman.com. The script name
  // is the deployment's identity: renaming it creates a second, empty Worker
  // and leaves the secrets, custom domains and observability history on the
  // old one. The name is not user-visible anywhere.
  "name": "blakebauman-dev",
  "compatibility_date": "2026-03-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./build/server/index.js",
  "assets": {
    "directory": "./build/client/"
  },
  // Custom domain routing. blakebauman.com is the primary; the two .dev domains
  // stay bound to this Worker so the host check at the top of workers/app.ts
  // fetch() can permanently redirect them. Unbinding them would strand every
  // existing link to the old domain.
  "routes": [
    { "pattern": "blakebauman.com", "custom_domain": true },
    { "pattern": "www.blakebauman.com", "custom_domain": true },
    { "pattern": "blakebauman.dev", "custom_domain": true },
    { "pattern": "www.blakebauman.dev", "custom_domain": true }
  ],
  // Secrets (wrangler secret put <NAME>):
  //   VECTORIZE_ADMIN_KEY - required for POST /api/populate-vectorize
  //   ADMIN_API_KEY       - required for GET /api/admin/chat-logs
  //   IP_HASH_SALT        - salts client-IP hashes before they reach D1; without
  //                         it the hashes are reversible by brute force and rows
  //                         are written with an "unsalted:" prefix
  "vars": {
    // Deployed (production) value. Local dev sets NODE_ENV=development via the dev
    // server. request.ts gates Vectorize search on process.env.NODE_ENV (baked at
    // build time), so this must not read "development" in production.
    "NODE_ENV": "production",
    "CHAT_ENABLED": "true",
    // Public read-only MCP server at /mcp (app/agent/mcp.ts).
    "MCP_ENABLED": "true",
    // Routes /api/chat through the tool-calling loop (app/agent/loop.ts).
    // Turning this off reverts to single-shot retrieval, which is also where
    // the loop falls back to on its own if it fails.
    "CHAT_AGENT_ENABLED": "true"
  },
  "observability": {
    "enabled": true
  },
  // Nightly chat-log retention sweep (see the scheduled handler in workers/app.ts).
  "triggers": {
    "crons": ["0 4 * * *"]
  },
  "ai": {
    "binding": "AI"
  },
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "resume-index-768"
    }
  ],
  // In-memory edge rate limiting for /api/chat (replaces the old KV counter).
  // period must be 10 or 60 seconds; limit is per key (client IP).
  "ratelimits": [
    {
      "name": "CHAT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ],
  "d1_databases": [
    {
      "binding": "CHAT_LOGS_DB",
      "database_name": "chat-logs",
      "database_id": "e21bde82-853b-4328-86f0-9e49a2aacf7c",
      "migrations_dir": "migrations"
    }
  ]
}
