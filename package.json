{
  "name": "blakebauman.dev",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "deploy": "pnpm run build && wrangler deploy",
    "dev": "react-router dev",
    "start": "wrangler dev --local",
    "typecheck": "react-router typegen && tsc -b",
    "vectorize:dev": "wrangler dev -c workers/wrangler.vectorize.toml --remote",
    "vectorize:deploy": "wrangler deploy -c workers/wrangler.vectorize.toml",
    "vectorize:populate": "curl -X POST https://vectorize-worker.edgeconfig.workers.dev/populate",
    "vectorize:query": "curl 'https://vectorize-worker.edgeconfig.workers.dev/query?q=edge%20computing'"
  },
  "dependencies": {
    "@react-router/node": "^7.2.0",
    "@react-router/serve": "^7.2.0",
    "agents": "^0.0.86",
    "isbot": "^5.1.23",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "@react-router/cloudflare": "^7.2.0",
    "@react-router/dev": "^7.2.0",
    "@tailwindcss/vite": "^4.0.7",
    "@types/node": "^20.17.19",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "tailwindcss": "^4.0.7",
    "typescript": "^5.7.3",
    "vite": "^5.4.14",
    "vite-tsconfig-paths": "^5.1.4",
    "wrangler": "^3.109.2"
  }
}
