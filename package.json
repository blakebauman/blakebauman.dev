{
  "name": "blakebauman.dev",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Blake Bauman <blake.bauman@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blakebauman/blakebauman.dev.git"
  },
  "scripts": {
    "build": "react-router build",
    "deploy": "pnpm run build && wrangler deploy",
    "dev": "react-router dev",
    "start": "wrangler dev --local",
    "typecheck": "react-router typegen && tsc -b",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "prepare": "lefthook install",
    "vectorize:populate": "curl -sS -X POST -H \"Authorization: Bearer $VECTORIZE_ADMIN_KEY\" https://blakebauman.dev/api/populate-vectorize",
    "vectorize:eval": "tsx scripts/eval-retrieval.ts",
    "sync:github": "tsx scripts/sync-github.ts"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@react-router/node": "^7.18.2",
    "@react-router/serve": "^7.18.2",
    "isbot": "^5.2.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.2",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@react-router/cloudflare": "^7.18.2",
    "@react-router/dev": "^7.18.2",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^3.2.7",
    "@vitest/ui": "^3.2.7",
    "jsdom": "^30.0.1",
    "lefthook": "^2.1.14",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^3.2.7",
    "wrangler": "^4.132.0"
  }
}
