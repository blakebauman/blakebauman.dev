{
  "name": "blakebauman.dev",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "deploy": "pnpm run build && wrangler deploy",
    "dev": "react-router dev",
    "start": "wrangler dev --local",
    "typecheck": "react-router typegen && tsc -b",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "prepare": "lefthook install",
    "vectorize:dev": "wrangler dev -c workers/vectorize/wrangler.toml --remote",
    "vectorize:deploy": "wrangler deploy -c workers/vectorize/wrangler.toml",
    "vectorize:populate": "curl -X POST -H \"Authorization: Bearer $VECTORIZE_ADMIN_KEY\" https://vectorize.blakebauman.dev/populate",
    "vectorize:query": "curl 'https://vectorize.blakebauman.dev/query?q=edge%20computing'"
  },
  "dependencies": {
    "@react-router/node": "^7.2.0",
    "@react-router/serve": "^7.2.0",
    "agents": "^0.0.86",
    "isbot": "^5.1.23",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router": "^7.2.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@cloudflare/workers-types": "^4.20250214.0",
    "@react-router/cloudflare": "^7.2.0",
    "@react-router/dev": "^7.2.0",
    "@tailwindcss/vite": "^4.0.7",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^20.17.19",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitest/coverage-v8": "^3.0.7",
    "@vitest/ui": "^3.0.7",
    "dotenv": "^16.4.5",
    "jsdom": "^26.0.0",
    "lefthook": "^2.1.1",
    "tailwindcss": "^4.0.7",
    "typescript": "^5.7.3",
    "vite": "^5.4.14",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.0.7",
    "wrangler": "^3.109.2"
  }
}
